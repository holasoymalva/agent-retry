{
  "name": "@agent-retry/adapter-ai-sdk",
  "version": "0.1.0",
  "description": "Provider-neutral AI SDK adapter for the Agent Retry runtime",
  "keywords": [
    "ai",
    "agent",
    "ai-sdk",
    "adapter",
    "retry",
    "recovery"
  ],
  "homepage": "https://github.com/holasoymalva/agent-retry#readme",
  "bugs": {
    "url": "https://github.com/holasoymalva/agent-retry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holasoymalva/agent-retry.git",
    "directory": "packages/adapter-ai-sdk"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@agent-retry/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=5 <8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
