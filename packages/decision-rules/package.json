{
  "name": "@agent-retry/decision-rules",
  "version": "0.1.0",
  "description": "Deterministic and hybrid recovery decisions for Agent Retry",
  "keywords": [
    "ai",
    "agent",
    "decision-engine",
    "retry",
    "recovery",
    "rules"
  ],
  "homepage": "https://github.com/holasoymalva/agent-retry#readme",
  "bugs": {
    "url": "https://github.com/holasoymalva/agent-retry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holasoymalva/agent-retry.git",
    "directory": "packages/decision-rules"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "agent-retry": "workspace:*"
  }
}
