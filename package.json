{
  "name": "agent-retry-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check package.json scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:pack": "pnpm build && node scripts/test-packed-packages.mjs",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsup": "9.0.0",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
